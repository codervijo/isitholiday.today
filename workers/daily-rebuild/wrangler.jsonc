// Cron-only Worker that triggers a scheduled Pages rebuild. See src/index.js
// for why. Pattern copied from montereybayevents.com/workers/daily-rebuild/.
//
// NOTE: this is NOT the site's deploy config. The site is a Cloudflare PAGES
// project, GitHub-integrated, `pnpm install && pnpm build` → dist, production
// branch main. This Worker exists only because Pages has no scheduler.
//
// Upload through the Cloudflare API (wrangler is not installed on the
// operator's host). This file is the source of record for what was uploaded.
//
// The DEPLOY_HOOK secret is deliberately absent — set it as a secret_text
// binding at upload time; never commit it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isitholiday-daily-rebuild",
  "main": "src/index.js",
  "compatibility_date": "2026-10-05",

  // Cloudflare cron is UTC with no DST handling. One run just after midnight
  // in each zone the site answers for:
  //   18:35 UTC → 00:05 IST (India; no DST)
  //   05:05 UTC → 00:05 EST / 01:05 EDT (US Eastern; USA + New York pages)
  //   08:05 UTC → 00:05 PST / 01:05 PDT (US Pacific; California page)
  // Texas (Central) flips at 05:00/06:00 UTC and is caught by the 05:05 run in
  // summer and the 08:05 run in winter. ~90 builds/month, under the Pages
  // free-tier 500.
  "triggers": {
    "crons": ["35 18 * * *", "5 5 * * *", "5 8 * * *"]
  },

  // No routes and no fetch handler: nothing public can trigger a deploy.
  "workers_dev": false
}
